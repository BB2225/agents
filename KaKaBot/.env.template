# ─────────────────────────────────────────────────────────────────────────────
# KaKaBot – Oracle-Lead Hybrid Lean Bot
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Web3 ─────────────────────────────────────────────────────────────────────
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# ── Polymarket CLOB API ──────────────────────────────────────────────────────
CLOB_API_KEY=your_clob_api_key
CLOB_API_SECRET=your_clob_api_secret
CLOB_API_PASSPHRASE=your_clob_passphrase

# ── Proxy Wallet (Magic/email accounts) ──────────────────────────────────────
POLYMARKET_FUNDER=0x_YOUR_PROXY_WALLET_ADDRESS

# ── Builder / Relayer (EOA only, for gasless merges) ─────────────────────────
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=

# ── Safety Guards ────────────────────────────────────────────────────────────
DRY_RUN=true
LIVE=false

# ── Capital ──────────────────────────────────────────────────────────────────
TOTAL_CAPITAL_USDC=300
PROFIT_TARGET_USDC=15
PROFIT_EXIT_USDC=25
MAX_MARKETS=15

# ── Z-Score Directional Model ───────────────────────────────────────────────
EDGE_THRESHOLD=0.03
Z_LEAN_ENTRY=1.15
Z_LEAN_MODERATE=1.75
Z_LEAN_STRONG=2.4
Z_LEAN_AGGRESSIVE=3.2
VOLATILITY_WINDOW_SEC=120

# ── Surplus Caps ─────────────────────────────────────────────────────────────
SURPLUS_CAP_Z1=0.15
SURPLUS_CAP_Z2=0.25
SURPLUS_CAP_Z3=0.40

# ── Neutral Mode ─────────────────────────────────────────────────────────────
NEUTRAL_SOFT_IMBALANCE=20
NEUTRAL_HARD_IMBALANCE=35

# ── Spread / Quoting ────────────────────────────────────────────────────────
CUSHION=0.02
REFRESH_INTERVAL_SEC=0.25

# ── Merge ────────────────────────────────────────────────────────────────────
MERGE_PAIR_THRESHOLD=75
MAX_PAIR_COST_TO_MERGE=0.985
MERGE_CHECK_INTERVAL_SEC=15

# ── Flip Risk ────────────────────────────────────────────────────────────────
FLIP_BASE_FRACTION=0.0003
FINAL_WINDOW_SEC=45
EMERGENCY_FLATTEN_SEC=60

# ── Cross-Market Dampener ───────────────────────────────────────────────────
DAMPENER_THRESHOLD_5=0.20
DAMPENER_THRESHOLD_8=0.35

# ── Max Trade Cap ────────────────────────────────────────────────────────────
MAX_TRADE_CAP=50

# ── Chainlink ────────────────────────────────────────────────────────────────
CHAINLINK_BTC_USD_ADDRESS=0xc907E116054Ad103354f2D350FD2514433D57F6f
CHAINLINK_POLL_INTERVAL_SEC=1.0
